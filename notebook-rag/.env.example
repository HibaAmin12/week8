# Copy this file to .env and fill in OPENAI_API_KEY. Everything else is optional.
OPENAI_API_KEY=
# --- Answer model and its price (USD per 1M tokens). Check platform.openai.com/docs/pricing ---
OPENAI_MODEL=gpt-6-luna
PRICE_IN=0.10
PRICE_OUT=0.50

# --- Embeddings: local (free, BAAI bge) or openai (billed) ---
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
# If EMBED_PROVIDER=openai, set the price too (default 0.02 = text-embedding-3-small)
# EMBED_PRICE_PER_M=0.02

# --- Retrieval ---
RERANK_ENABLED=true
TOP_K=8

# --- Chunking (re-upload files after changing) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- OCR for scanned PDFs / images ---
OCR_ENABLED=true
OCR_LANG=eng
